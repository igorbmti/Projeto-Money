# ==============================================================================
# GARIMPRO - Configurações de Ambiente (Exemplo)
# Copie este arquivo para .env no servidor de produção e preencha com os dados reais
# NUNCA envie senhas reais para o GitHub.
# ==============================================================================

# Conexão com Banco de Dados MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=controle_vendas
DB_USER=root
DB_PASS=

# Configuração de CORS (Informe o domínio do Frontend na Vercel para restringir a origem)
# Exemplo: CORS_ALLOWED_ORIGIN=https://seu-projeto.vercel.app,http://localhost
CORS_ALLOWED_ORIGIN=*

# Ambiente da Aplicação
APP_ENV=development
